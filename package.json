{
  "name": "the-crawl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx apps/server/src/index.ts --dev",
    "host": "node dist/server.js",
    "build": "npm run typecheck && vite build --config apps/client/vite.config.ts && esbuild apps/server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx tools/validate.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "coverage:content": "tsx tools/coverage.ts",
    "soak": "tsx tools/soak.ts",
    "share": "node -e \"console.log('For an explicitly authorized private remote test, see docs/HOSTING.md. No tunnel is started automatically.')\"",
    "soak:browser": "tsx tools/browser-soak.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.16.26",
    "@colyseus/schema": "3.0.69",
    "@colyseus/ws-transport": "0.16.5",
    "ajv": "8.17.1",
    "colyseus.js": "0.16.22",
    "express": "4.21.2",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "4.17.21",
    "@types/node": "24.10.0",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.4"
  }
}
